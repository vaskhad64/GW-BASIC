10 REM *** MENSCH AERGERE DICH NICHT - RICHTIGE LAUFRICHTUNG ***
20 SCREEN 7: CLS: KEY OFF: COLOR 15, 0
30 DIM FX(56), FY(56): DIM PF(4)
40 REM
50 REM --- 1. KOORDINATEN DER 40 LAUFELDER EINLESEN ---
60 FOR F = 1 TO 40
70   READ FX(F), FY(F)
80 NEXT F
90 REM
100 REM --- 2. SPIELERANZAHL ABFRAGEN ---
110 PRINT "MENSCH AERGERE DICH NICHT"
120 INPUT "WIE VIELE MENSCHLICHE SPIELER (1-4): ", MAXSP
130 IF MAXSP < 1 OR MAXSP > 4 THEN GOTO 120
140 CLS
150 REM
160 REM --- 3. SPIELFELD GRAFISCH ZEICHNEN ---
170 FOR F = 1 TO 40
180   CIRCLE (FX(F), FY(F)), 5, 15: REM Weisse Standardfelder
190 NEXT F
200 REM
210 REM --- 4. SONDERFELDER & STARTPUNKTE ---
220 CIRCLE (FX(1), FY(1)), 5, 9:   PAINT (FX(1), FY(1)), 9, 9:     REM Blau startet bei 1
230 CIRCLE (FX(11), FY(11)), 5, 12: PAINT (FX(11), FY(11)), 12, 12: REM Rot startet bei 11
240 CIRCLE (FX(21), FY(21)), 5, 10: PAINT (FX(21), FY(21)), 10, 10: REM Gruen startet bei 21
250 CIRCLE (FX(31), FY(31)), 5, 14: PAINT (FX(31), FY(31)), 14, 14: REM Gelb startet bei 31
260 REM
270 REM --- 5. ZIELHÄUSER IM SPEICHER SPEICHERN & ZEICHNEN ---
280 FOR Z = 1 TO 4
290   FX(40+Z) = 160: FY(40+Z) = 40 + Z*13:        CIRCLE (FX(40+Z), FY(40+Z)), 5, 9   : REM Blau Haus (runter)
300   FX(44+Z) = 225 - Z*13: FY(44+Z) = 105:       CIRCLE (FX(44+Z), FY(44+Z)), 5, 12  : REM Rot Haus (nach links)
310   FX(48+Z) = 160: FY(48+Z) = 170 - Z*13:       CIRCLE (FX(48+Z), FY(48+Z)), 5, 10  : REM Gruen Haus (hoch)
320   FX(52+Z) = 95 + Z*13:  FY(52+Z) = 105:       CIRCLE (FX(52+Z), FY(52+Z)), 5, 14  : REM Gelb Haus (nach rechts)
330 NEXT Z
340 REM
350 REM --- 6. FIGUREN AUF IHRE ECHTEN STARTPUNKTE SETZEN ---
360 PF(1) = 1:  PF(2) = 11: PF(3) = 21: PF(4) = 31
370 CIRCLE (FX(PF(1)), FY(PF(1))), 3, 9:  PAINT (FX(PF(1)), FY(PF(1))), 9, 9
380 CIRCLE (FX(PF(2)), FY(PF(2))), 3, 12: PAINT (FX(PF(2)), FY(PF(2))), 12, 12
390 CIRCLE (FX(PF(3)), FY(PF(3))), 3, 10: PAINT (FX(PF(3)), FY(PF(3))), 10, 10
400 CIRCLE (FX(PF(4)), FY(PF(4))), 3, 14: PAINT (FX(PF(4)), FY(PF(4))), 14, 14
410 REM
420 SP = 1: REM Start mit Spieler 1
430 GOTO 500: REM Hauptschleife starten
440 REM
450 REM --- DATA: IM UHRZEIGERSINN SORTIERT ---
460 DATA 173,40, 173,53, 173,66, 173,79, 173,92
461 DATA 186,92, 199,92, 212,92, 225,92, 225,105
462 DATA 225,118, 212,118, 199,118, 186,118, 173,118
463 DATA 173,131, 173,144, 173,157, 173,170, 160,170
464 DATA 147,170, 147,157, 147,144, 147,131, 147,118
465 DATA 136,118, 123,118, 110,118, 97,118, 97,105
466 DATA 97,92, 110,92, 123,92, 136,92, 147,92
467 DATA 147,79, 147,66, 147,53, 147,40, 160,40
500 REM
510 REM --- HAUPTSCHLEIFE ---
520 LOCATE 2, 1: PRINT "                                        "
530 PRINT "                                        "
540 LOCATE 2, 1: PRINT "SPIELER "; SP;
550 FC = 9: IF SP = 2 THEN FC = 12 ELSE IF SP = 3 THEN FC = 10 ELSE IF SP = 4 THEN FC = 14
560 REM
570 IF SP <= MAXSP THEN PRINT " (DU) - LEERTASTE WUERFELN!" ELSE PRINT " (PC) - DENKT NACH..."
580 IF SP > MAXSP THEN FOR T = 1 TO 8000: NEXT T: GOTO 610
590 K$ = INKEY$: IF K$ <> " " THEN GOTO 590
610 REM
620 REM --- WÜRFELN ---
630 W = INT(RND * 6) + 1
640 LINE (10, 50)-(40, 80), 15, BF
650 IF W = 1 OR W = 3 OR W = 5 THEN CIRCLE (25, 65), 1, 0: PAINT (25, 65), 0, 0
660 IF W >= 2 THEN CIRCLE (17, 57), 1, 0: PAINT (17, 57), 0, 0: CIRCLE (33, 73), 1, 0: PAINT (33, 73), 0, 0
670 IF W >= 4 THEN CIRCLE (33, 57), 1, 0: PAINT (33, 57), 0, 0: CIRCLE (17, 73), 1, 0: PAINT (17, 73), 0, 0
680 IF W = 6 THEN CIRCLE (17, 65), 1, 0: PAINT (17, 65), 0, 0: CIRCLE (33, 65), 1, 0: PAINT (33, 65), 0, 0
690 REM
700 REM --- FIGUR BEWEGEN ---
710 P = PF(SP): ALT = P
720 REM 1. Alte Position auf dem Spielfeld loeschen
730 C = 15: IF P = 1 THEN C = 9
731 IF P = 11 THEN C = 12
732 IF P = 21 THEN C = 10
733 IF P = 31 THEN C = 14
734 IF P > 40 THEN C = FC
735 CIRCLE (FX(P), FY(P)), 5, C: PAINT (FX(P), FY(P)), 0, C
740 REM
750 REM 2. Neue Position berechnen (Abbiegen ins Haus)
760 P = P + W
770 IF SP = 1 AND ALT <= 40 AND P > 40 THEN P = 40 + (P - 40)
780 IF SP = 2 AND ALT <= 10 AND P > 10 AND ALT > 4 THEN P = 44 + (P - 10)
790 IF SP = 3 AND ALT <= 20 AND P > 20 AND ALT > 14 THEN P = 48 + (P - 20)
800 IF SP = 4 AND ALT <= 30 AND P > 30 AND ALT > 24 THEN P = 52 + (P - 30)
810 IF ALT <= 40 AND P > 40 THEN P = P - 40
820 REM
830 REM Zu weites Laufen im Haus verhindern
840 IF SP = 1 AND P > 44 THEN P = ALT
850 IF SP = 2 AND P > 48 THEN P = ALT
860 IF SP = 3 AND P > 52 THEN P = ALT
870 IF SP = 4 AND P > 56 THEN P = ALT
880 REM
890 REM 3. Neue Position speichern und zeichnen
900 PF(SP) = P
910 CIRCLE (FX(P), FY(P)), 3, FC: PAINT (FX(P), FY(P)), FC, FC
920 SOUND 400 + SP*50, 1
930 REM
940 REM --- GEWINN-PRÜFUNG ---
950 IF SP = 1 AND P = 44 THEN GOTO 1130
960 IF SP = 2 AND P = 48 THEN GOTO 1130
970 IF SP = 3 AND P = 52 THEN GOTO 1130
980 IF SP = 4 AND P = 56 THEN GOTO 1130
990 REM
1000 REM --- SCHLAG-LOGIK PRÜFEN ---
1010 IF P > 40 THEN GOTO 1070
1020 FOR O = 1 TO 4
1030   IF O = SP THEN GOTO 1060
1040   IF PF(O) <> P THEN GOTO 1060
1050   SOUND 150, 5: PF(O) = (O-1)*10 + 1
1055   OC = 9: IF O = 2 THEN OC = 12 ELSE IF O = 3 THEN OC = 10 ELSE IF O = 4 THEN OC = 14
1056   CIRCLE (FX(PF(O)), FY(PF(O))), 3, OC: PAINT (FX(PF(O)), FY(PF(O))), OC, OC
1060 NEXT O
1070 REM
1080 REM --- PAUSE & SPIELERWECHSEL ---
1090 FOR T = 1 TO 5000: NEXT T
1100 SP = SP + 1: IF SP > 4 THEN SP = 1
1110 GOTO 510
1120 REM
1130 REM --- 7. GEWINNER-BILDSCHIRM ---
1140 CLS: LOCATE 10, 10: PRINT "SPIELER "; SP; " HAT GEWONNEN!!!"
1150 FOR I = 1 TO 5: SOUND 500 + I*100, 2: NEXT I
1160 END
